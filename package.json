{
  "name": "indie-md",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "extract-advice": "npx tsx scripts/extract-advice.ts",
    "screenshot": "node scripts/screenshot-products.mjs",
    "gif": "node scripts/url-to-gif.mjs",
    "build": "npm run extract-advice && astro build",
    "preview": "astro preview",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "lint:writing": "bash scripts/lint-writing.sh",
    "lint:seo": "bash scripts/lint-seo.sh",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && npm run lint:writing && npm run typecheck && npm run extract-advice && npm run test && npm run build && npm run lint:seo",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.2.9",
    "remark-directive": "^4.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
